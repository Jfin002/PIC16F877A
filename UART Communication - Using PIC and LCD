#define SW1 RB0
#define SW2 RB1
#define VALID RC0

void main(void)
{
    ADCON1 = 0x06;      // ? IMPORTANT
    TRISB = 0xFF;       // Switches
    TRISD = 0x00;       // Data bus
    TRISC0 = 0;         // VALID output

    OPTION_REGbits.nRBPU = 0; // Enable PORTB pull-ups

    PORTD = 0;
    VALID = 0;

    while(1)
    {
        if(SW1 == 0)   // ACTIVE LOW
        {
            PORTD = 0x01;
            VALID = 1;
            __delay_ms(200);
            VALID = 0;
            while(SW1 == 0); // wait release
        }

        if(SW2 == 0)   // ACTIVE LOW
        {
            PORTD = 0x02;
            VALID = 1;
            __delay_ms(200);
            VALID = 0;
            while(SW2 == 0);
        }
    }
}


