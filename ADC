void main(void) 
{
    PWM1_Init();
    ADC_Init();
    while(1)
    {
        PWM1_Set_Duty(ADC_Read(0)); // Set PWM Duty Cycle To AN0_Result!
        __delay_ms(1);
    }
    return;
}
